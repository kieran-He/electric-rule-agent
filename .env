APP_NAME=feishu-power-policy-bot
HOST=0.0.0.0
PORT=8000
CHROMA_PATH=./data/chroma
DOCS_ROOT=./data/docs
INGEST_INDEX_PATH=./data/chroma/ingest_index.json
TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
TESSDATA_PREFIX=e:/newprojects/firstmodel/tools/tessdata
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

GLM_API_KEY=
GLM_ENDPOINT=https://open.bigmodel.cn/api/paas/v4/chat/completions
GLM_MODEL=glm-4.5

FEISHU_VERIFICATION_TOKEN=
FEISHU_SIGNING_SECRET=
FEISHU_APP_ID=
FEISHU_APP_SECRET=

PROVINCE_CONFIDENCE_THRESHOLD=0.7
TOP_K=5
EVENT_TTL_SECONDS=600
OCR_ENABLED=true
OCR_MIN_CH_RATIO=0.08
OCR_MAX_REPLACEMENT_RATIO=0.03
OCR_EMPTY_PAGE_THRESHOLD=0.3
