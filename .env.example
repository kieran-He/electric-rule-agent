APP_NAME=feishu-power-policy-bot
HOST=0.0.0.0
PORT=8000
INGEST_ENABLED=false
CHROMA_PATH=./data/chroma
DOCS_ROOT=./data/docs
INGEST_INDEX_PATH=./data/chroma/ingest_index.json
TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
TESSDATA_PREFIX=
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

LLM_PROVIDER=anthropic
LLM_API_KEY=your-api-key-here
LLM_ENDPOINT=https://api.minimaxi.com/anthropic
LLM_MODEL=MiniMax-M2.7
LLM_TIMEOUT_SECONDS=120

RAGAS_ENABLED=true
RAGAS_USE_MOCK=false
RAGAS_ENDPOINT=https://api.minimaxi.com/anthropic
RAGAS_API_KEY=your-ragas-api-key-here
RAGAS_MODEL=MiniMax-M2.7

FEISHU_VERIFICATION_TOKEN=
FEISHU_SIGNING_SECRET=
FEISHU_APP_ID=your-feishu-app-id
FEISHU_APP_SECRET=your-feishu-app-secret

PROVINCE_CONFIDENCE_THRESHOLD=0.7
TOP_K=12
EVENT_TTL_SECONDS=600
OCR_ENABLED=true
OCR_MIN_CH_RATIO=0.08
OCR_MAX_REPLACEMENT_RATIO=0.03
OCR_EMPTY_PAGE_THRESHOLD=0.3

USE_LANGCHAIN=true

USE_HYBRID_RETRIEVAL=true
HYBRID_VECTOR_TOP_K=15
HYBRID_BM25_TOP_K=15
HYBRID_FINAL_TOP_K=12

RERANKER_MODEL=BAAI/bge-reranker-large
RERANKER_PRELOAD=true
RERANKER_MAX_LENGTH=512

BM25_K1=1.5
BM25_B=0.6

QUERY_EXPANSION=true
QUERY_EXPANSION_METHOD=semantic
QUERY_EXPANSION_MAX=5
QUERY_REWRITE_ENABLED=true
QUERY_REWRITE_ALWAYS=true
QUERY_REWRITE_KEEP_ORIGINAL=false

# Web Search (Tavily API)
WEB_SEARCH_ENABLED=true
TAVILY_API_KEY=your-tavily-api-key-here
WEB_SEARCH_MAX_RESULTS=5